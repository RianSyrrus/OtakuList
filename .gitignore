*.jks
*.keystore
*.p12
*.key
*.pem
keystore.properties
**/keystore.properties
.env
.env.*
*.env
**/secrets.xml
**/google-services.json

# =====================================================================
# 2. ANDROID, GRADLE & IDE ARTIFACTS
# =====================================================================
*.iml
.gradle/
**/build/
local.properties
**/local.properties
.idea/
**/.idea/
.kotlin/
**/.kotlin/
.DS_Store
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# =====================================================================
# 3. PYTHON SCRAPER & SYNC TOOLS (tools/)
# =====================================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
tools/data/

# =====================================================================
